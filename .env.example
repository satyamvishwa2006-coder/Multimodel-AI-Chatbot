# ==============================================================
# MULTIMODAL AI CHATBOT MVP - ENVIRONMENT CONFIGURATION
# ==============================================================

APP_NAME="Multimodal AI Assistant"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL with pgvector)
# Format: postgresql+psycopg2://username:password@localhost:5432/mchatbot
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/mchatbot"
FALLBACK_SQLITE_URL="sqlite:///./mchatbot.db"

# AI Provider Configuration ("openai", "gemini", "mock")
# Default "mock" allows running without any external API keys
LLM_PROVIDER="mock"
EMBEDDING_PROVIDER="mock"

# OpenAI Configuration (Optional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_VISION_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Gemini Configuration (Optional)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Web Search Configuration (Optional)
TAVILY_API_KEY=""

# RAG Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=4
EMBEDDING_DIMENSION=1536

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15
